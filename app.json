{
  "expo": {
    "name": "NEXA",
    "slug": "gadgetstock",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/nexa-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pabloluna.nexa"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/nexa-foreground.png",
        "monochromeImage": "./assets/nexa-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pabloluna.nexa"
    },
    "web": {
      "favicon": "./assets/nexa-favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "NEXA usa tus fotos para agregar imágenes a los productos.",
          "cameraPermission": "NEXA usa la cámara para fotografiar productos."
        }
      ],
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "cameraPermission": "NEXA usa la cámara para leer las etiquetas QR de tus productos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "NEXA usa Face ID para desbloquear tu espacio cuando vos lo elegís."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-sensors",
        {
          "motionPermission": "NEXA usa el acelerómetro y el giroscopio para comprobar la inclinación de estanterías."
        }
      ]
    ],
    "scheme": "nexa"
  }
}
